# Copy this file to .env and fill in your own values. Never commit .env.
# Supabase public settings (anon/publishable key - safe for client use)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Vite client (same values, VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only - NEVER commit the real value
# SUPABASE_SERVICE_ROLE_KEY=
